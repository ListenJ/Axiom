# Axiom Runtime - Production Environment
# 复制此文件为 .env 并填入实际值
# NEVER commit .env to git

# ============================================
# 核心服务配置
# ============================================
AXIOM_GATEWAY_PORT=18789
AXIOM_AUTH_TOKEN=CHANGE_THIS_TO_32_CHAR_RANDOM_HEX

# ============================================
# 数据库
# ============================================
DATABASE_URL=./data/agent.db

# ============================================
# AI 提供商 API Keys (至少配置一个)
# ============================================
# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax
MINIMAX_API_KEY=your-minimax-key
MINIMAX_BASE_URL=https://api.minimax.chat

# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google AI
GOOGLE_API_KEY=your-google-key
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# xAI
XAI_API_KEY=your-xai-key
XAI_BASE_URL=https://api.x.ai

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com

# Groq
GROQ_API_KEY=your-groq-key
GROQ_BASE_URL=https://api.groq.com

# 01.AI
YI_API_KEY=your-yi-key
YI_BASE_URL=https://api.01.ai

# ============================================
# 搜索配置
# ============================================
SERPAPI_KEY=your-serpapi-key
TAVILY_API_KEY=your-tavily-key
BING_API_KEY=your-bing-key
GOOGLE_CSE_API_KEY=your-google-cse-key
GOOGLE_CSE_CX=your-google-cse-cx

# ============================================
# 可选功能开关
# ============================================
# 启用 MCP 工具
ENABLE_MCP=true

# 启用代码索引
ENABLE_CODE_INDEX=true

# 启用 WebSocket 实时通知
ENABLE_WEBSOCKET=true

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# 安全配置
# ============================================
# CORS 允许的域名（逗号分隔）
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# 速率限制：每分钟最大请求数
RATE_LIMIT_PER_MINUTE=60

# 请求体大小限制（MB）
MAX_BODY_SIZE=10

# ============================================
# 自建 SearXNG（可选增强）
# ============================================
# Axiom 自带 11 个匿名引擎，未部署 SearXNG 也能完整使用搜索。
# 生产部署建议：只在 compose 网络内暴露，不要对外发布 8080 端口。
# 部署：bash scripts/deploy-searxng.sh
# 容器内由 compose 覆盖为 http://searxng:8080；裸机部署才需要显式设置。
# SEARXNG_INSTANCE=http://127.0.0.1:8080

# 加密密钥：必须用 openssl rand -hex 32 生成，**禁止使用示例值上线**。
# 两个变量名对应两个消费者，必须同值（deploy 脚本会自动保证）：
#   SEARXNG_SECRET_KEY  → Axiom 应用读取（config/web-search.yaml: secret_key_env）
#   SEARXNG_SECRET      → SearXNG 容器读取（上游 environ_name）
# 生产环境请用编排平台的 secret 注入，不要写进镜像或提交到仓库（AGENTS.md 规则 11）。
SEARXNG_SECRET_KEY=change-me-openssl-rand-hex-32
SEARXNG_SECRET=change-me-openssl-rand-hex-32

# 端口：默认仅绑 127.0.0.1（见 docker-compose.yml）
# SEARXNG_PORT=8080
# SEARXNG_VERSION=latest
# 公开实例/限流场景需要 valkey（默认已随栈启动）
# SEARXNG_LIMITER=false
