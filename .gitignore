# ============================================
# Axiom AI Agent .gitignore
# 只上传 README.md 和核心代码到 GitHub
# 其他文档需手动下载
# ============================================

# === Dependencies ===
node_modules/

# === Build output ===
dist/
*.tsbuildinfo

# === Environment variables ===
.env
.env.local
.env.*.local

# === Data ===
data/*.db
data/*.json
data/raw/

# === Logs ===
*.log
logs/

# === OS ===
.DS_Store
Thumbs.db

# === IDE ===
.idea/
.vscode/
*.swp
*.swo

# === Obsidian ===
.obsidian/

# === Python ===
.venv/

# === OMC state ===
.omc/

# === Generated memory content ===
openclaw-memory/
axiom-memory/

# === Temporary files ===
.tmp/
.tmp-build/

# === Test results ===
test-results/
playwright-report/
coverage/
frontend/coverage/

# === Evaluation results ===
eval-results/
e2e/

# === Generated test fixtures ===
tests/fixtures/agents-index.json
tests/fixtures/agents/

# === Vendored dependencies ===
vendor/

# === Backup files ===
*.bundle

# === SQLite databases ===
openclaw-memory.db
openclaw-memory.db-*
axiom-memory.db
axiom-memory.db-*

# === Lightpanda ===
lightpanda-linux

# ============================================
# 不上传 GitHub 的文件
# 需要时从本地下载或重新生成
# ============================================

