# ============================================
# Axiom AI Agent .gitignore
# 只上传 README.md 和核心代码到 GitHub
# 其他文档需手动下载
# ============================================

# === Dependencies ===
node_modules/

# === Build output ===
dist/
*.tsbuildinfo
# Vite hashed build artifacts (regenerated every build, no need to track)
public/assets/

# === Environment variables ===
.env
.env.local
.env.*.local

# === Data ===
data/*.db
data/*.json
data/raw/
data/model-outputs/

# === Logs ===
*.log
logs/

# === OS ===
.DS_Store
Thumbs.db

# === IDE ===
.idea/
.vscode/
*.swp
*.swo

# === Obsidian ===
.obsidian/

# === Python ===
.venv/

# === OMC state ===
.omc/

# === Generated memory content ===
openclaw-memory/
axiom-memory/

# === Temporary files ===
.tmp/
.tmp-build/

# === Test results ===
test-results/
playwright-report/
coverage/
frontend/coverage/

# === Stress test reports (generated by scripts/stress-runner.ts) ===
reports/

# === Evaluation results ===
# 实验记录文档归档入库（忽略其余运行时产物）
eval-results/*
!eval-results/*.md
!eval-results/.gitkeep
!eval-results/.gitignore

# === E2E 截图（脚本产物不入库；spec/config 需入库供 CI 运行） ===
e2e/*.png
e2e/**/*.png

# === Generated test fixtures ===
tests/fixtures/agents-index.json
tests/fixtures/agents/

# === Vendored dependencies ===
vendor/

# === Backup files ===
*.bundle

# === SQLite databases ===
openclaw-memory.db
openclaw-memory.db-*
axiom-memory.db
axiom-memory.db-*
# WAL / SHM 运行时临时文件
data/*.db-shm
data/*.db-wal

# === Lightpanda ===
lightpanda-linux

# === OCR trained data (large binary, re-downloadable) ===
*.traineddata

# === Runtime PID / server state ===
.server-pid.txt
.tmp-server.log

# === Proxy config (local network specific) ===
mihomo-config/

# === Scratch / temp directories ===
tmp/
.tmp-e2e/

# ============================================
# 不上传 GitHub 的文件
# 需要时从本地下载或重新生成
# ============================================

# 文档 (除 README 外)
docs/architecture-evolution.md
docs/MCP_TOOLS_GUIDE.md
CHANGELOG.md

# Docker
docker-compose.yml
Dockerfile
Dockerfile.lightpanda

# 前端 — 自 2026-07-20 起纳入版本控制
# 历史原因：此前误标为“未使用”，实际已有 64+ 文件被跟踪且持续开发。
# frontend/

# Tauri
src-tauri/

# Python
python_libs/

# Native bindings
native/

# 部署配置
deploy/

# 审计/分析报告
.audits/
.codegraph/
.workbuddy/

# Archive
archive/

# === IDE / Tooling ===
.trae/

# === Personal notes ===
ai-daily-*.md

# === Runtime artifacts ===
.session-context.json
.tmp-tool-test/
.tmp-*
*.tmp

# SDD progress
.superpowers/

# === Local-only tools / sensitive docs (not for repo) ===
# media-tools/: 本地媒体处理 PowerShell 脚本，与项目无关
media-tools/
# docs/services.md: 服务器服务清单（含 SSH 凭据等敏感信息），禁止入库
docs/services.md

# === DSH plugin generated preview screenshots ===
plugins/dsh/preview/screenshots/
