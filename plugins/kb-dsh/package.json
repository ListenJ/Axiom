{
  "name": "axiom-kb-dsh",
  "version": "0.1.0",
  "description": "Axiom Knowledge Base (KB) as a DeepSeek Harness (dsh) plugin: bridges the Vault memory (memory_*) and knowledge-graph (kg_*/kal_*/dip_*) tools into dsh under the `kb__` prefix. Bundles its own memory + KG backend; no web-search tools.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "backend"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run build:backend",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000 tests/",
    "build:backend": "bun build ../../src/kb/backend/mcp-server.ts --target=bun --outfile backend/server.js --minify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ListenJ/axiom-kb-dsh.git",
    "directory": "plugins/kb-dsh"
  },
  "homepage": "https://github.com/ListenJ/axiom-kb-dsh#readme",
  "bugs": {
    "url": "https://github.com/ListenJ/axiom-kb-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "knowledge-base",
    "memory",
    "knowledge-graph",
    "mcp"
  ]
}
