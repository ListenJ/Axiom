{
  "apps": [
    {
      "name": "openclaw-fusion",
      "script": "./src/main.ts",
      "interpreter": "bun",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "BUN_ENV": "production"
      },
      "env_production": {
        "NODE_ENV": "production",
        "BUN_ENV": "production"
      },
      "log_file": "./logs/combined.log",
      "out_file": "./logs/out.log",
      "error_file": "./logs/error.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "max_memory_restart": "1G",
      "restart_delay": 3000,
      "max_restarts": 5,
      "min_uptime": "10s",
      "listen_timeout": 10000,
      "kill_timeout": 5000,
      "wait_ready": true,
      "shutdown_with_message": true,
      "source_map_support": true
    }
  ]
}