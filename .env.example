# ============================================================================
# Axiom AI Agent — 环境变量配置模板
# 复制此文件为 .env 并填入实际密钥
# 警告: .env 文件包含敏感信息，切勿提交到版本控制
# ============================================================================

# ========== 模型平台 API 密钥 (至少需配置一个) ==========

# DeepSeek 官方: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 硅基流动: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
# OfoxAI: https://ofox.ai/
OFOXAI_API_KEY=sk-your-ofoxai-key-here
# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# 智谱 AI（GLM 免费模型：glm-4.7-flash 提示词优化/知识库、glm-4.6v-flash 视觉）: https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here
# 月之暗面 KIMI: https://platform.moonshot.cn/（model-router 架构/代码层后备）
KIMI_API_KEY=sk-your-kimi-key-here
# OpenCode Go 套餐: https://opencode.ai/（deepseek-v4-flash 等评测/编码模型；kimi-k2.6 视觉）
OPENCODE_API_KEY=sk-your-opencode-key-here
# OpenCode 套餐视觉模型（GLM 视觉限流/失败时自动回退；默认 kimi-k2.6 已实测支持图像）
# OPENCODE_VISION_MODEL=kimi-k2.6
# MiniMax: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-key-here
# NVIDIA NIM: https://integrate.api.nvidia.com/
NIM_API_KEY=nvapi-your-nim-key-here
# ---- 海外变体（可选） ----
# DEEPSEEK_OVERSEAS_API_KEY=
# KIMI_OVERSEAS_API_KEY=
# ZHIPU_OVERSEAS_API_KEY=
# MINIMAX_OVERSEAS_API_KEY=
# ---- OfoxAI 扩展协议（可选） ----
# OFOXAI_ANTHROPIC_API_KEY=
# OFOXAI_GEMINI_API_KEY=

# ========== 网关配置 ==========

# Gateway 认证令牌 (至少 16 位随机字符串)
AXIOM_AUTH_TOKEN=your-secure-random-token-at-least-16-chars

# 回环地址(127.0.0.1/::1)免认证开关，默认 1（便于本地开发与 E2E 测试）。
# 若在本机同主机部署反向代理(nginx 等)，必须设为 0 —— 否则所有经代理的
# 请求在 socket 层都来自 127.0.0.1，会被误判为本地请求而绕过认证。
# AXIOM_ALLOW_LOCAL_BYPASS=0

# ========== 记忆系统配置 ==========

# Obsidian Vault 路径
OBSIDIAN_VAULT_PATH=./axiom-memory
# SQLite 数据库文件路径
DATABASE_PATH=./data/agent.db

# ========== 日志配置 ==========

LOG_LEVEL=info

# ── 内部视觉审核（scripts/visual-audit.ts）──
# GLM 免费视觉模型 glm-4v-flash 需要智谱 API Key（与上方 ZHIPU_API_KEY 复用）
# GLM_VISION_MODEL=glm-4v-flash
# GLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4


# ========== GLM 免费模型（提示词优化 / 视觉 / 知识库） ==========

# 提示词优化模型（glm-4.7-flash 免费）：结合项目上下文（PROMPT_PROJECT_CONTEXT）更精准地改写用户提示词
# PROMPT_OPTIMIZER_MODEL=glm-4.7-flash
# PROMPT_OPTIMIZER_PROVIDER=zhipu
# PROMPT_OPTIMIZER_FALLBACK_MODEL=glm-4-flash
# PROMPT_OPTIMIZER_FALLBACK_PROVIDER=zhipu
# 项目上下文（可选，例如 CodeGraph 索引摘要/项目说明；默认取项目路径）
# PROMPT_PROJECT_CONTEXT=

# 视觉模型（glm-4.6v-flash 免费）：scripts/visual-audit.ts 与知识库图/视频视觉任务
# GLM_VISION_MODEL=glm-4.6v-flash
# GLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 知识库管理模型（glm-4.7-flash 免费）：结构化/蒸馏等内部任务
# KNOWLEDGE_LLM_MODEL=glm-4.7-flash
# KNOWLEDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
