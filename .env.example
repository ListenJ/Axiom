# Axiom Runtime — 环境变量配置示例
# 复制本文件为 .env 并填入你的 API Key（不要提交 .env 到 Git）
# 使用交互式配置向导: bun run cli setup

# ══════════════════════════════════════════════════════════════
# 核心模型提供商 (至少配置 2-3 个以确保冗余)
# ══════════════════════════════════════════════════════════════

# DeepSeek — 高性价比中文模型 (DeepSeek V4 Pro/Flash, R1)
# 注册: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow — 国内聚合平台 (Qwen3, DeepSeek, GLM 等)
# 注册: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OFOX AI — 海外聚合平台 (GPT-5.5, Claude 4.7, Gemini 3.1)
# 注册: https://ofox.ai
OFOXAI_API_KEY=sk-your-ofoxai-key
OFOXAI_BASE_URL=https://api.ofoxai.com/v1

# OpenRouter — 全球模型路由 (627+ 模型)
# 注册: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_PROXY=

# ══════════════════════════════════════════════════════════════
# 可选模型提供商 (按需配置)
# ══════════════════════════════════════════════════════════════

# OFOX AI Anthropic 专用通道 (Claude Opus 4.7, Claude Sonnet 4.6)
OFOXAI_ANTHROPIC_API_KEY=sk-your-ofoxai-anthropic-key
OFOXAI_ANTHROPIC_BASE_URL=https://api.ofoxai.com/anthropic

# OFOX AI Gemini 专用通道 (Gemini 3.1 Pro, Gemini 3.5 Flash)
OFOXAI_GEMINI_API_KEY=sk-your-ofoxai-gemini-key
OFOXAI_GEMINI_BASE_URL=https://api.ofoxai.com/gemini

# OpenCode — 代码专用模型
# 注册: https://opencode.gg
OPENCODE_API_KEY=your-opencode-key
OPENCODE_BASE_URL=https://api.opencode.gg/v1
OPENCODE_DEFAULT_MODEL=opencode/deepseek-v4-flash-free

# Kimi (Moonshot) — 超长上下文 256K+
# 注册: https://platform.moonshot.cn
KIMI_API_KEY=your-kimi-key
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Kimi Code — 编程助手 (可选，与 KIMI_API_KEY 二选一)
# 控制台: https://www.kimi.com/code
KIMI_CODE_API_KEY=your-kimi-code-api-key

# MiniMax — 海螺AI (M2.7, M3)
# 注册: https://platform.minimax.chat
MINIMAX_API_KEY=your-minimax-key
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Together AI — 开源模型专用推理 (Llama 4, Qwen3 等)
# 注册: https://www.together.ai
TOGETHER_AI_API_KEY=your-together-ai-key
TOGETHER_AI_BASE_URL=https://api.together.xyz/v1

# Fireworks AI — 超低延迟推理 (Llama 4, 提示缓存)
# 注册: https://fireworks.ai
FIREWORKS_AI_API_KEY=your-fireworks-ai-key
FIREWORKS_AI_BASE_URL=https://api.fireworks.ai/inference/v1

# Replicate — 社区模型 (按时间计费)
# 注册: https://replicate.com
REPLICATE_API_KEY=your-replicate-key
REPLICATE_BASE_URL=https://api.replicate.com/v1

# NVIDIA NIM — 免费推理平台 (GLM5.1, DeepSeek V4, Qwen3 等)
# 注册: https://build.nvidia.com (需要启用 Public API Endpoints)
NIM_API_KEY=your-nvidia-nim-key

# ══════════════════════════════════════════════════════════════
# MCP 搜索服务器（免费方案，无需 API Key）
# ══════════════════════════════════════════════════════════════
# Context7: 远程文档查询服务，无需配置
# free-search: DuckDuckGo/Mojeek/Startpage 本地搜索
# freeweb: 网页浏览和内容提取

# GitHub — 代码仓库访问 (可选)
GITHUB_TOKEN=ghp-your-github-token

# ══════════════════════════════════════════════════════════════
# 记忆管理
# ══════════════════════════════════════════════════════════════

OBSIDIAN_VAULT_PATH=./axiom-memory
OBSIDIAN_API_TOKEN=
DATABASE_PATH=./data/agent.db

# ══════════════════════════════════════════════════════════════
# 高级配置 (可选)
# ══════════════════════════════════════════════════════════════

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 上下文窗口最大使用率 (0.0-1.0, 超过将触发分割)
CONTEXT_MAX_USAGE=0.6

# 并行读取线程数
PARALLEL_READ_THREADS=3

# 是否启用优雅降级
ENABLE_GRACEFUL_DEGRADATION=true

# CodeGraph 自动索引间隔 (毫秒)
CODEGRAPH_REINDEX_INTERVAL=30000

# ══════════════════════════════════════════════════════════════
# 网关安全
# ══════════════════════════════════════════════════════════════

AXIOM_AUTH_TOKEN=your_secure_random_token_here
