# OpenClaw AI Agent — 环境变量配置示例
# 复制本文件为 .env 并填入你的 API Key（不要提交 .env 到 Git）

# ===== 网关安全 =====
OPENCLAW_AUTH_TOKEN=your_secure_random_token_here

# ===== 模型平台 API Key =====
# 硅基流动 (SiliconFlow) — 国内直连，7个永久免费模型
# 注册: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# OfoxAI — OpenRouter 国内替代，10个免费模型
# 注册: https://ofox.ai
OFOXAI_API_KEY=sk-your-ofoxai-key

# DeepSeek — 官方 API，V4-Flash 成本极低
# 注册: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenRouter — 兜底备用，353+ 模型
# 注册: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_HTTP_PROXY=

# OpenCode — 编码 Agent 免费模型网关
# 注册: https://opencode.ai
OPENCODE_API_KEY=your-opencode-key
OPENCODE_DEFAULT_MODEL=opencode/deepseek-v4-flash-free

# Kimi Code — Kimi 会员智能编程服务
# 控制台: https://www.kimi.com/code
# 模型 ID: kimi-for-coding (固定 ID，后端自动升级)
KIMI_CODE_API_KEY=your-kimi-code-api-key

# ===== 数据采集 =====
SERPAPI_KEY=your-serpapi-key

# ===== 记忆管理 =====
OBSIDIAN_VAULT_PATH=./openclaw-memory
OBSIDIAN_API_TOKEN=
DATABASE_PATH=./data/agent.db

# ===== 可选：平台自定义端点 =====
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# OFOXAI_BASE_URL=https://api.ofox.ai/v1
# OFOXAI_ANTHROPIC_BASE_URL=https://api.ofox.ai/anthropic
# OFOXAI_GEMINI_BASE_URL=https://api.ofox.ai/gemini
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
