# ============================================================================
# Axiom AI Agent — 环境变量配置模板（全模型供应商版）
# 复制此文件为 .env 并填入实际密钥；.env.example 保留作为模板备份。
# 警告: .env 包含敏感信息，切勿提交到版本控制。
#
# 密钥加载规则（src/utils/api-key-store.ts 为权威表）：
#   优先级 = 运行时 API 覆盖(HTTP) > 环境变量 > 内置默认
#   任意供应商可额外设置 <前缀>_BASE_URL 覆盖内置端点（如 DEEPSEEK_BASE_URL）
# ============================================================================

# ============================================================================
# 一、模型平台 API 密钥（至少配置一个即可运行）
# ============================================================================

# ── DeepSeek 官方（V4 直连）: https://platform.deepseek.com/ ──
# 模型: deepseek-v4-flash / deepseek-v4-pro（deepseek-chat/reasoner 已于 2026-07-24 弃用）
# 思考模式默认开启；轻任务(general-tool/review/general-chat 等)默认关闭以降低延迟
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── SiliconFlow 硅基流动: https://cloud.siliconflow.cn/ ──
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ── OfoxAI: https://ofox.ai/ ──
OFOXAI_API_KEY=sk-your-ofoxai-key-here
# OFOXAI_BASE_URL=https://api.ofoxai.com

# ── OpenRouter（聚合 400+ 模型，含免费模型）: https://openrouter.ai/ ──
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── 智谱 AI GLM（含免费模型 glm-4.7-flash / glm-4.6v-flash）: https://open.bigmodel.cn/ ──
ZHIPU_API_KEY=your-zhipu-api-key-here
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── 月之暗面 KIMI: https://platform.moonshot.cn/ ──
KIMI_API_KEY=sk-your-kimi-key-here
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── MiniMax: https://platform.minimaxi.com/ ──
MINIMAX_API_KEY=your-minimax-key-here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ── NVIDIA NIM（GLM5.1/DeepSeek V4 等旗舰）: https://integrate.api.nvidia.com/ ──
NIM_API_KEY=nvapi-your-nim-key-here
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── OpenCode Go 套餐（OpenAI 兼容扩展）: https://opencode.ai/ ──
# deepseek-v4-flash 等评测/编码模型；kimi-k2.6 视觉（GLM 视觉限流/失败时自动回退）
OPENCODE_API_KEY=sk-your-opencode-key-here
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_VISION_MODEL=kimi-k2.6

# ── OfoxAI 扩展协议（可选） ──
# OFOXAI_ANTHROPIC_API_KEY=
# OFOXAI_ANTHROPIC_BASE_URL=https://api.ofoxai.com/anthropic
# OFOXAI_GEMINI_API_KEY=
# OFOXAI_GEMINI_BASE_URL=https://api.ofoxai.com/gemini

# ── OpenAI 官方（通用后备，hermes-agent / DRE presets 读取）: https://platform.openai.com/ ──
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 海外变体（同一端点分流用，可选） ──
# DEEPSEEK_OVERSEAS_API_KEY=
# DEEPSEEK_OVERSEAS_BASE_URL=https://api.deepseek.com/v1
# KIMI_OVERSEAS_API_KEY=
# KIMI_OVERSEAS_BASE_URL=https://api.moonshot.ai/v1
# ZHIPU_OVERSEAS_API_KEY=
# ZHIPU_OVERSEAS_BASE_URL=https://api.z.ai/api/paas/v4
# MINIMAX_OVERSEAS_API_KEY=
# MINIMAX_OVERSEAS_BASE_URL=https://api.minimax.io/v1

# ============================================================================
# 二、DeepSeek 峰谷计费调度（2026-08-16 起官方峰谷价）
# ============================================================================
# 高峰时段: 01:00-04:00 与 06:00-10:00 UTC（谷价 = 峰价一半）
# 调度策略: 高峰时 deepseek-v4-pro 有效优先级 +8 → flash/免费/其他供应商优先；谷时恢复 pro 优先
# 设为 0/false/no 可关闭峰谷调度（恒用注册表原优先级）
DEEPSEEK_PEAK_SCHEDULING=1

# 成本估算 CNY→USD 汇率（默认 7.2；非官方假设值，仅用于成本面板 USD/CNY 双币展示）
# COST_CNY_PER_USD=7.2

# ============================================================================
# 三、GLM 免费模型（内部任务：提示词优化 / 视觉 / 知识库）
# ============================================================================

# 提示词优化模型（glm-4.7-flash 免费）：结合 PROMPT_PROJECT_CONTEXT 更精准改写用户提示词
# PROMPT_OPTIMIZER_MODEL=glm-4.7-flash
# PROMPT_OPTIMIZER_PROVIDER=zhipu
# PROMPT_OPTIMIZER_FALLBACK_MODEL=glm-4-flash
# PROMPT_OPTIMIZER_FALLBACK_PROVIDER=zhipu
# 项目上下文（可选，例如 CodeGraph 索引摘要/项目说明；默认取项目路径）
# PROMPT_PROJECT_CONTEXT=

# 视觉模型（glm-4.6v-flash 免费）：scripts/visual-audit.ts 与知识库图/视频视觉任务
# GLM_VISION_MODEL=glm-4.6v-flash
# GLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 知识库管理模型（glm-4.7-flash 免费）：结构化/蒸馏等内部任务
# KNOWLEDGE_LLM_MODEL=glm-4.7-flash
# KNOWLEDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================================================================
# 四、网关配置
# ============================================================================

# Gateway 认证令牌 (至少 16 位随机字符串)
AXIOM_AUTH_TOKEN=your-secure-random-token-at-least-16-chars

# 回环地址(127.0.0.1/::1)免认证开关，默认 1（便于本地开发与 E2E 测试）。
# 若在本机同主机部署反向代理(nginx 等)，必须设为 0 —— 否则所有经代理的
# 请求在 socket 层都来自 127.0.0.1，会被误判为本地请求而绕过认证。
# AXIOM_ALLOW_LOCAL_BYPASS=0

# ============================================================================
# 五、记忆系统配置
# ============================================================================

# Obsidian Vault 路径
OBSIDIAN_VAULT_PATH=./axiom-memory
# SQLite 数据库文件路径
DATABASE_PATH=./data/agent.db

# ============================================================================
# 六、日志配置
# ============================================================================

LOG_LEVEL=info
# ============================================================================
# 七、提示词优化 / 缓存优化（2026-08-14 强化）
# ============================================================================

# 提示词优化器开关（0/false 关闭；兼容旧开关 EDGE_PROMPT_REWRITE=0）
# PROMPT_REWRITE=1
# EDGE_PROMPT_REWRITE=1
# 优化输入截断上限（字符；默认 2000）
# PROMPT_OPTIMIZER_MAX_INPUT_CHARS=2000
# 优化结果去重缓存 TTL（毫秒；默认 1 小时）
# PROMPT_OPTIMIZER_CACHE_TTL_MS=3600000

# 语义答案缓存（归一化查询级确定性缓存；english/translation/evaluation 等 temperature=0 任务）
# 0/false 关闭；默认开启
# SEMANTIC_CACHE_ENABLED=1

# ============================================================================
# 八、网关 / 服务细节
# ============================================================================

# HTTP 绑定地址与端口（config-center 权威：AXIOM_GATEWAY_PORT 默认 18789）
# HOST=127.0.0.1
# AXIOM_GATEWAY_PORT=18789
# AXIOM_BIND=127.0.0.1
# 请求体上限（字节；默认 1048576）
# MAX_BODY_SIZE=1048576
# NODE_ENV=development
# CORS 允许来源（逗号分隔；默认允许本地端口）
# CORS_ORIGINS=
# CORS_CREDENTIALS=0
# MCP 服务器端口/绑定（默认 127.0.0.1:3001）
# MCP_PORT=3001
# MCP_HOST=127.0.0.1
# CSP connect-src 额外白名单（逗号分隔）
# CSP_CONNECT_SRC=
# 本地回环免认证开关（反向代理同机部署时必须设 0）
# AXIOM_ALLOW_LOCAL_BYPASS=1

# ============================================================================
# 九、原生 / 本地能力
# ============================================================================

# Rust 原生核心开关（搜索/路由加速；默认开启）
# AXIOM_NATIVE=1
# AXIOM_EDITION=local
# 插件目录（Axiom 自身插件系统，默认 ./plugins）
# AXIOM_PLUGIN_DIR=./plugins
# 神经突触心智模块数据库（默认 ./data/synapse.db）
# AXIOM_SYNAPSE_DB=./data/synapse.db
# OCR Tesseract 语言数据目录（默认仓库根，含本地 eng.traineddata，离线可用）
# TESSERACT_LANG_PATH=./
# 外部 PDF worker 地址（文档摄取 PDF→Markdown，可选）
# AXIOM_PDF_WORKER_URL=
# SenseNova 视觉模型（前端视觉审核；密钥优先 env，其次 ~/.axiom/axiom-secrets/sensenova.credentials）
# SENSENOVA_API_KEY=
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_VISION_MODEL=sensenova-6.8-flash-lite
# 隐私模式（1 时禁止一切云端 LLM，仅本地边缘模型）
# AXIOM_PRIVACY_MODE=0
# WebSocket 最大客户端数（默认 100）
# AXIOM_WS_MAX_CLIENTS=100
# 终端白名单（逗号分隔命令；默认放行基础命令）
# AXIOM_TERMINAL_WHITELIST=
# 外部可恢复输出存储（条目数/阈值字节/TTL 毫秒）
# AXIOM_EXTERNAL_RECOVERABLE_MAX_ENTRIES=1000
# AXIOM_EXTERNAL_RECOVERABLE_THRESHOLD=8192
# AXIOM_EXTERNAL_RECOVERABLE_TTL_MS=3600000
# 敏感配置加密密钥（本地非仓库保存）
# AXIOM_ENCRYPTION_KEY=
# Lightpanda 浏览器路径（headless 渲染/截图，可选）
# LIGHTPANDA_PATH=

# ============================================================================
# 十、外部服务
# ============================================================================

# GitHub API（代码分析/PR 工具）
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# SerpAPI 深度搜索
# SERPAPI_KEY=
# Bing 搜索（可选）
# BING_API_KEY=
# Redis（L2 缓存，可选）
# REDIS_URL=
# PostgreSQL（知识图谱等，可选）
# DATABASE_URL=
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=axiom
# PG_PASSWORD=axiom
# PG_DATABASE=axiom
# SearXNG 实例（搜索兜底）
# SEARXNG_INSTANCE=https://search.sapti.me

# ============================================================================
# 十一、记忆 / 知识库 / 技能目录
# ============================================================================

# 知识库 SQLite 路径
# KNOWLEDGE_DB_PATH=./data/knowledge.db
# 内存/会话 SQLite 路径
# SQLITE_MEMORY_DB=./axiom-memory.db
# 技能/Agent 指令目录
# SKILL_DIR=./skills
# AGENTS_DIR=./data/agents
# AGENCY_AGENTS_DIR=
# AGENTS_INDEX_PATH=./data/agents-index.json
# Obsidian 本地 API（可选）
# OBSIDIAN_API_PORT=27124
# OBSIDIAN_API_TOKEN=
# CodeGraph 自动索引（config-center；默认开）
# CODEGRAPH_AUTO_INDEX=1

# ============================================================================
# 十二、爬虫 / 检索
# ============================================================================

# CRAWLER_MAX_CONCURRENT=3
# CRAWLER_REQUEST_DELAY=1000
# CRAWLER_SEARCH_API=multi-engine

# ============================================================================
# 十三、嵌入 / 边缘模型
# ============================================================================

# EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1/embeddings
# EMBEDDINGS_MODEL=BAAI/bge-m3
# EDGE_LLM_URL=http://127.0.0.1:9001
# EDGE_LLM_MODEL=MiniCPM5-1B
# EDGE_LLM_TRANSPORT=ollama
# EDGE_EMBED_URL=
# EDGE_EMBED_MODEL=
# EDGE_SETTINGS_SEARCH=1
# GLM_FLASH_MODEL=glm-4.7-flash
# GLM_FLASH_PROVIDER=zhipu

# ============================================================================
# 十四、模型默认 / 审查 / 内部任务
# ============================================================================

# 审查/判官模型（代码审查、忠实度判别等）
# REVIEW_MODEL=THUDM/GLM-5.1
# JUDGE_MODEL=anthropic/claude-sonnet-4.6
# DRE 缺口填补微调（0/1）
# DRE_GAP_FILL_FINE=0
# 意识观察循环（默认开启）
# CONSCIOUSNESS_ENABLED=1
# KIMI Code 智能体（可选）
# KIMI_CODE_API_KEY=
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
# OpenCode 默认模型
# OPENCODE_DEFAULT_MODEL=deepseek-v4-flash
# 模型输出落盘（0/1）
# MODEL_OUTPUT_PERSIST=1

# ============================================================================
# 十五、网络代理（出站）
# ============================================================================

# SEARCH_PROXY=http://127.0.0.1:7890  # 网络搜索专用代理（mihomo 等 HTTP 代理）；仅搜索走代理，避免 Bun TLS 隧道影响其他 HTTPS 调用
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=http://127.0.0.1:7890
# PROXY_URL=http://127.0.0.1:7890


# ============================================================================
# 十六、DRE 确定性推理引擎（本地/云端配置）
# ============================================================================

# 主服务宿主集成开关（0 关闭；默认开启，提供 POST /dre/run 与 /pipeline/stream 观测）
# AXIOM_DRE_ENABLED=1
# Agent 权限档位: readonly(只读) / readwrite(读写，默认) / full(完全操作，仍需沙箱验证)
# AXIOM_AGENT_PERMISSION=readwrite
# SQLite 数据库路径
# DRE_DB_PATH=./data/dre.db
# 主推理模型端点（默认本地 llama.cpp；OpenAI 兼容端点可直接填云端，如 https://api.deepseek.com/v1）
# DRE_LLM_URL=http://127.0.0.1:8080
# DRE_LLM_MODEL=qwen3-1.7b-instruct
# 主推理模型 API Key（指向云端端点时必填；本地 llama.cpp 可省略）
# DRE_LLM_API_KEY=
# 确定性采样参数（temperature=0/topK=1/seed=42 保证可回放）
# DRE_LLM_TEMPERATURE=0
# DRE_LLM_TOP_K=1
# DRE_LLM_SEED=42
# 甄别小模型（可选；三段甄别阶段 3 用）
# DRE_DISCRIMIN_URL=
# DRE_DISCRIMIN_MODEL=qwen3-0.6b-instruct
# DRE_DISCRIM_API_KEY=
# Kernel 驱动循环
# DRE_TICK_INTERVAL=10000
# DRE_AUTO_TICK=1
# 工作记忆容量 / 情景记忆 TTL（毫秒）
# DRE_WORKING_MEMORY_CAPACITY=16
# DRE_EPISODIC_TTL=3600000
# 云降级（本地 LLM 失败时）：复用 DEEPSEEK_API_KEY；模型/端点可独立覆盖
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1



