# ============================================================================
# Axiom AI Agent — 环境变量配置模板
# 复制此文件为 .env 并填入实际密钥
# 警告: .env 文件包含敏感信息，切勿提交到版本控制
# ============================================================================

# ========== 模型平台 API 密钥 (至少需配置一个) ==========

# DeepSeek 官方: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 硅基流动: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
# OfoxAI: https://ofox.ai/
OFOXAI_API_KEY=sk-your-ofoxai-key-here
# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ========== 网关配置 ==========

# Gateway 认证令牌 (至少 16 位随机字符串)
AXIOM_AUTH_TOKEN=your-secure-random-token-at-least-16-chars

# 回环地址(127.0.0.1/::1)免认证开关，默认 1（便于本地开发与 E2E 测试）。
# 若在本机同主机部署反向代理(nginx 等)，必须设为 0 —— 否则所有经代理的
# 请求在 socket 层都来自 127.0.0.1，会被误判为本地请求而绕过认证。
# AXIOM_ALLOW_LOCAL_BYPASS=0

# ========== 记忆系统配置 ==========

# Obsidian Vault 路径
OBSIDIAN_VAULT_PATH=./axiom-memory
# SQLite 数据库文件路径
DATABASE_PATH=./data/agent.db

# ========== 日志配置 ==========

LOG_LEVEL=info

# ── 内部视觉审核（scripts/visual-audit.ts）──
# GLM 免费视觉模型 glm-4v-flash 需要智谱 API Key（与上方 ZHIPU_API_KEY 复用）
# GLM_VISION_MODEL=glm-4v-flash
# GLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
