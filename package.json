{
  "name": "axiom-agent",
  "version": "4.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "axiom": "bun run src/launcher.ts",
    "ocl": "bun run src/launcher.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun",
    "build:matrix": "bun run scripts/build/matrix.ts",
    "build:list": "bun run scripts/build/matrix.ts --list",
    "build:server": "bun run scripts/build/matrix.ts --target=server --platform=current",
    "build:cli": "bun run scripts/build/matrix.ts --target=cli --platform=current",
    "build:mcp": "bun run scripts/build/matrix.ts --target=mcp --platform=current",
    "build:frontend": "bun run scripts/build/matrix.ts --target=frontend",
    "build:tauri": "bun run scripts/build/matrix.ts --target=tauri",
    "build:go": "bun run scripts/build/matrix.ts --target=go --platform=current",
    "build:all": "bun run scripts/build/matrix.ts --target=all --platform=current",
    "build:cross": "bun run scripts/build/matrix.ts --target=all --platform=all",
    "mcp": "bun run src/mcp/server.ts",
    "mcp:external": "bun run src/mcp/server.ts --external",
    "mcp:external:setup": "bun run scripts/setup-external-mcp.ts",
    "cli": "bun run src/cli.ts",
    "health": "bun run scripts/health-check.ts",
    "audit:runtime": "bun run scripts/runtime-audit.ts",
    "audit:frontend": "bun run scripts/frontend-audit.ts",
    "discover": "bun run scripts/discover-free-models.ts",
    "migrate": "bun run src/db/migrate.ts",
    "demo": "bun run scripts/demo-crawl.ts",
    "serpapi": "bun run scripts/serpapi-search.ts",
    "eval": "bun run src/eval/eval-cli.ts",
    "eval:run": "bun run src/eval/eval-cli.ts eval --full --benchmarks",
    "eval:quick": "bun run src/eval/eval-cli.ts eval",
    "eval:assign": "bun run src/eval/eval-cli.ts assign",
    "eval:stats": "bun run src/eval/eval-cli.ts stats",
    "eval:legacy": "bun run src/eval/eval-runner.ts",
    "kg:build": "bun run src/cli.ts kg:build",
    "kg:stats": "bun run src/cli.ts kg:stats",
    "kg:search": "bun run src/cli.ts kg:search",
    "advisor:recommend": "bun run src/cli.ts advisor:recommend",
    "advisor:free": "bun run src/cli.ts advisor:free",
    "advisor:evolve": "bun run src/cli.ts advisor:evolve",
    "research": "bun run src/cli.ts research",
    "db:init": "bun run src/db/pg-init.ts",
    "test": "bun test --parallel=8 ./tests",
    "test:e2e": "node scripts/run-e2e.cjs",
    "lint": "tsc --noEmit",
    "code:open": "bun run src/cli.ts code:open",
    "code:models": "bun run src/cli.ts code:models",
    "agent:status": "bun run src/cli.ts agent:status",
    "setup:agents": "bun run scripts/setup-agents.ts",
    "start:daemon": "bun run scripts/start.ts daemon",
    "start:prod": "bun run scripts/start.ts prod",
    "stop": "bun run scripts/start.ts stop",
    "restart": "bun run scripts/start.ts restart",
    "status": "bun run scripts/start.ts status",
    "logs": "bun run scripts/start.ts logs",
    "install:wizard": "bun run src/tui/install-wizard.ts",
    "postinstall": "bun run scripts/ensure-env.ts",
    "help": "bun run src/cli.ts help --all",
    "tools": "bun run scripts/tools.ts",
    "menu": "bun run scripts/tools.ts",
    "workflow": "bun run scripts/workflow.ts",
    "wip": "bun run scripts/workflow.ts continue",
    "summary": "bun run scripts/session-summary.ts",
    "clean": "bun -e \"const fs=require('fs');['.tmp-tool-test','data/session.json','.session-context.json'].forEach(f=>fs.rmSync(f,{recursive:true,force:true}));console.log('cleaned')\"",
    "native:build": "cd native && cargo build --release -p axiom-local",
    "native:build:cloud": "cd native && cargo build --release -p axiom-cloud",
    "native:run:local": "bun run scripts/run-native.ts local",
    "native:run:cloud": "bun run scripts/run-native.ts cloud",
    "tui": "bun run src/tui/app.ts",
    "tui:install": "bun run src/tui/install-wizard.ts",
    "tauri:dev": "cd frontend && bun install && tauri dev",
    "tauri:build": "cd frontend && bun install && bun run build && cd .. && tauri build",
    "test:core": "bun test tests/cache-stress.test.ts tests/thompson-stress.test.ts tests/vib-compressor.test.ts tests/redis-client.test.ts tests/module-exports.test.ts tests/services-chat.test.ts tests/registry-validation.test.ts tests/property-based.test.ts tests/tools-v3.test.ts tests/review-deep.test.ts tests/dre-memory-deep.test.ts tests/adapt-tool.test.ts",
    "test:arch": "bun test tests/architecture-integrity.test.ts",
    "test:perf": "bun test tests/perf-benchmark.test.ts",
    "test:stress": "bun test tests/stress/extreme-stress.test.ts",
    "test:gate": "bun test tests/stress/perf-gate.test.ts",
    "stress:run": "bun run scripts/stress-runner.ts",
    "stress:baseline": "bun run scripts/stress-runner.ts --baseline",
    "stress:compare": "bun run scripts/stress-runner.ts --compare",
    "stress:report": "bun run scripts/stress-report.ts",
    "stress:trend": "bun run scripts/stress-report.ts --trend",
    "test:integration": "bun test tests/integration-edge.test.ts",
    "test:full": "bun test tests/architecture-integrity.test.ts tests/cache-stress.test.ts tests/thompson-stress.test.ts tests/vib-compressor.test.ts tests/redis-client.test.ts tests/module-exports.test.ts tests/services-chat.test.ts tests/registry-validation.test.ts tests/property-based.test.ts tests/tools-v3.test.ts tests/review-deep.test.ts tests/dre-memory-deep.test.ts tests/adapt-tool.test.ts tests/perf-benchmark.test.ts tests/integration-edge.test.ts tests/e2e-runtime.test.ts",
    "cache:baseline": "bun run scripts/cache-baseline.ts"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "^0.9.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "blessed": "^0.1.81",
    "mammoth": "^1.12.1",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/blessed": "^0.1.27",
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
