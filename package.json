{
  "name": "axiom-agent",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "axiom": "bun run src/launcher.ts",
    "ocl": "bun run src/launcher.ts",
    "build": "bun build src/main.ts --outdir ./dist --target bun",
    "mcp": "bun run src/mcp/server.ts",
    "cli": "bun run src/cli.ts",
    "health": "bun run scripts/health-check.ts",
    "discover": "bun run scripts/discover-free-models.ts",
    "migrate": "bun run src/db/migrate.ts",
    "demo": "bun run scripts/demo-crawl.ts",
    "serpapi": "bun run scripts/serpapi-search.ts",
    "eval": "bun run src/eval/eval-cli.ts",
    "eval:run": "bun run src/eval/eval-cli.ts eval --full --benchmarks",
    "eval:quick": "bun run src/eval/eval-cli.ts eval",
    "eval:assign": "bun run src/eval/eval-cli.ts assign",
    "eval:stats": "bun run src/eval/eval-cli.ts stats",
    "eval:legacy": "bun run src/eval/eval-runner.ts",
    "kg:build": "bun run src/cli.ts kg:build",
    "kg:stats": "bun run src/cli.ts kg:stats",
    "kg:search": "bun run src/cli.ts kg:search",
    "advisor:recommend": "bun run src/cli.ts advisor:recommend",
    "advisor:free": "bun run src/cli.ts advisor:free",
    "advisor:evolve": "bun run src/cli.ts advisor:evolve",
    "research": "bun run src/cli.ts research",
    "db:init": "bun run src/db/pg-init.ts",
    "test": "bun test tests/",
    "test:e2e": "node scripts/run-e2e.cjs",
    "lint": "tsc --noEmit",
    "code:open": "bun run src/cli.ts code:open",
    "code:models": "bun run src/cli.ts code:models",
    "agent:status": "bun run src/cli.ts agent:status",
    "setup:agents": "bash scripts/setup-agents.sh",
    "start:daemon": "bash scripts/start.sh daemon",
    "start:prod": "bash scripts/start.sh prod",
    "stop": "bash scripts/start.sh stop",
    "restart": "bash scripts/start.sh restart",
    "status": "bash scripts/start.sh status",
    "logs": "bash scripts/start.sh logs",
    "install:wizard": "bun run src/tui/install-wizard.ts",
    "help": "bun run src/cli.ts help --all",
    "tools": "bun run scripts/tools.ts",
    "menu": "bun run scripts/tools.ts",
    "workflow": "bun run scripts/workflow.ts",
    "wip": "bun run scripts/workflow.ts continue",
    "summary": "bun run scripts/session-summary.ts",
    "clean": "bun -e \"const fs=require('fs');['.tmp-tool-test','data/session.json','.session-context.json'].forEach(f=>fs.rmSync(f,{recursive:true,force:true}));console.log('cleaned')\"",
    "native:build": "cd native && cargo build --release --features local",
    "native:build:cloud": "cd native && cargo build --release --features cloud",
    "native:run:local": "./native/target/release/axiom-local",
    "native:run:cloud": "./native/target/release/axiom-cloud",
    "tui": "bun run src/tui/app.ts",
    "tui:install": "bun run src/tui/install-wizard.ts",
    "tauri:dev": "cd frontend && bun install && tauri dev",
    "tauri:build": "cd frontend && bun install && bun run build && cd .. && tauri build",
    "test:core": "bun test tests/cache-stress.test.ts tests/thompson-stress.test.ts tests/vib-compressor.test.ts tests/redis-client.test.ts tests/module-exports.test.ts tests/services-chat.test.ts tests/registry-validation.test.ts tests/property-based.test.ts tests/tools-v3.test.ts tests/review-deep.test.ts tests/dre-memory-deep.test.ts tests/adapt-tool.test.ts"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "^0.9.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "blessed": "^0.1.81",
    "opencode-ai": "^1.17.10",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/blessed": "^0.1.27",
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
