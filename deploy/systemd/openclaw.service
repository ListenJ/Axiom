[Unit]
Description=OpenClaw AI Agent
Documentation=https://github.com/ListenJ/openclaw-fusion
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/openclaw-fusion
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="NODE_ENV=production"
EnvironmentFile=-/opt/openclaw-fusion/.env
ExecStart=/usr/local/bin/bun run src/main.ts
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=append:/var/log/openclaw.log
StandardError=append:/var/log/openclaw.log
SyslogIdentifier=openclaw

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openclaw-fusion/data /opt/openclaw-fusion/.codegraph

[Install]
WantedBy=multi-user.target
