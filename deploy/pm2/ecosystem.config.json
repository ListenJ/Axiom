{
  "apps": [
    {
      "name": "openclaw-agent",
      "script": "src/main.ts",
      "interpreter": "bun",
      "cwd": ".",
      "env": {
        "NODE_ENV": "production"
      },
      "env_development": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug"
      },
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "1G",
      "restart_delay": 5000,
      "max_restarts": 10,
      "min_uptime": "10s",
      "merge_logs": true,
      "log_file": "./data/logs/openclaw-combined.log",
      "out_file": "./data/logs/openclaw-out.log",
      "error_file": "./data/logs/openclaw-error.log",
      "time": true,
      "kill_timeout": 30000,
      "listen_timeout": 10000,
      "autorestart": true,
      "post_restart": "echo 'OpenClaw restarted at $(date)'"
    }
  ]
}
